[spark-store]
name=Spark Store for Evernight Vista $releasever
baseurl=https://download.copr.fedorainfracloud.org/results/xmp360/spark-store/fedora-43-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/xmp360/spark-store/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1